# ─── REQUIRED (app will not boot without these) ────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/qreatestudios"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ─── OPTIONAL — Feature-gated (app boots without, features disabled) ──

# AI Features (GPT-4o) — enables AI QR optimization, copy generation, SEO
OPENAI_API_KEY="sk-..."

# Billing (Stripe) — enables checkout, subscriptions, billing portal
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRO_PRICE_ID="price_..."
STRIPE_BUSINESS_PRICE_ID="price_..."
STRIPE_AGENCY_PRICE_ID="price_..."

# Email (Resend) — enables transactional emails, order notifications
RESEND_API_KEY="re_..."
FROM_EMAIL="noreply@yourdomain.com"
ADMIN_EMAIL="admin@yourdomain.com"
SUPPORT_EMAIL="support@yourdomain.com"

# GitHub OAuth — enables "Sign in with GitHub" (Credentials auth always works)
GITHUB_ID="..."
GITHUB_SECRET="..."

# Image Search (Unsplash) — enables stock image search in editor
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY="..."

# Analytics Maps (Mapbox) — enables scan heatmap visualization
NEXT_PUBLIC_MAPBOX_TOKEN="pk...."

# Rate Limiting (Upstash Redis) — enables API rate limiting
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# App URL (used for absolute links in emails, QR codes)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
