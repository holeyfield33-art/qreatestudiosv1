generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AIUsage {
  id               String   @id
  userId           String
  feature          String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  cost             Float
  createdAt        DateTime @default(now())
  User             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Analytics {
  id         String   @id
  qrCodeId   String
  scannedAt  DateTime @default(now())
  deviceType String?
  browser    String?
  os         String?
  country    String?
  city       String?
  ipAddress  String?
  userAgent  String?
  referrer   String?
  QRCode     QRCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([scannedAt])
}

model AuditLog {
  id         String   @id
  userId     String
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([action])
  @@index([createdAt])
  @@index([userId])
}

model Client {
  id             String        @id
  userId         String
  organizationId String?
  name           String
  email          String?
  phone          String?
  address        String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  Organization   Organization? @relation(fields: [organizationId], references: [id])
  User           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  Menu           Menu[]
  QRCode         QRCode[]

  @@index([organizationId])
  @@index([userId])
}

model Contact {
  id          String   @id
  userId      String
  name        String
  email       String?
  phone       String?
  company     String?
  contactType String   @default("lead")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Note        Note[]
  Task        Task[]

  @@index([userId])
}

model FeatureFlag {
  id          String   @id
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

model LandingPage {
  id        String   @id
  userId    String
  qrCodeId  String?  @unique
  title     String
  slug      String   @unique
  content   Json
  theme     Json?
  published Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  QRCode    QRCode?  @relation(fields: [qrCodeId], references: [id])
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([userId])
}

model Menu {
  id              String         @id
  userId          String
  clientId        String?
  name            String
  description     String?
  slug            String         @unique
  businessName    String?
  businessAddress String?
  businessCity    String?
  businessState   String?
  businessZip     String?
  businessPhone   String?
  businessEmail   String?
  businessWebsite String?
  language        String         @default("en")
  currency        String         @default("USD")
  timezone        String         @default("America/New_York")
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  Client          Client?        @relation(fields: [clientId], references: [id])
  User            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  MenuCategory    MenuCategory[]
  QRCode          QRCode[]

  @@index([clientId])
  @@index([slug])
  @@index([userId])
}

model MenuCategory {
  id           String     @id
  menuId       String
  name         String
  description  String?
  displayOrder Int        @default(0)
  createdAt    DateTime   @default(now())
  Menu         Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  MenuItem     MenuItem[]

  @@index([menuId])
}

model MenuItem {
  id           String       @id
  categoryId   String
  name         String
  description  String?
  price        Float
  imageUrl     String?
  isAvailable  Boolean      @default(true)
  dietaryTags  Json?
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime
  MenuCategory MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

model Note {
  id        String   @id
  contactId String
  userId    String
  content   String
  createdAt DateTime @default(now())
  Contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([userId])
}

model Organization {
  id                 String               @id
  name               String
  ownerId            String
  settings           Json?
  isWhiteLabel       Boolean              @default(false)
  customDomain       String?              @unique
  branding           Json?
  smtpConfig         Json?
  revenueShare       Int                  @default(70)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  plan               String               @default("FREE")
  Client             Client[]
  OrganizationMember OrganizationMember[]
  QRCode             QRCode[]
  User               User[]

  @@index([customDomain])
  @@index([ownerId])
}

model OrganizationMember {
  id             String       @id
  organizationId String
  userId         String
  role           String
  joinedAt       DateTime     @default(now())
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model PrintOrder {
  id                       String    @id
  userId                   String
  qrCodeId                 String
  orderNumber              String    @unique
  productType              String
  quantity                 Int
  specifications           Json
  specialInstructions      String?
  shippingAddress          Json
  totalPrice               Float
  status                   String    @default("pending")
  trackingNumber           String?
  customerEmail            String?
  customerPhone            String?
  adminNotificationSent    Boolean   @default(false)
  customerNotificationSent Boolean   @default(false)
  shippedAt                DateTime?
  estimatedDelivery        DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime
  QRCode                   QRCode    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  User                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([qrCodeId])
  @@index([status])
  @@index([userId])
}

model QRCode {
  id              String           @id
  userId          String
  clientId        String?
  organizationId  String?
  name            String
  description     String?
  type            QRCodeType
  data            String
  shortCode       String           @unique
  redirectUrl     String
  style           Json?
  logoUrl         String?
  isDynamic       Boolean          @default(true)
  isSecure        Boolean          @default(false)
  password        String?
  expiresAt       DateTime?
  maxScans        Int?
  scanCount       Int              @default(0)
  status          String           @default("active")
  isActive        Boolean          @default(true)
  isBanned        Boolean          @default(false)
  bannedReason    String?
  bannedAt        DateTime?
  paymentProvider PaymentProvider?
  paymentHandle   String?
  paymentAmount   Float?
  paymentCurrency String?          @default("USD")
  paymentNote     String?
  allowTips       Boolean          @default(false)
  tipAmounts      Json?
  menuId          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  Analytics       Analytics[]
  LandingPage     LandingPage?
  PrintOrder      PrintOrder[]
  Client          Client?          @relation(fields: [clientId], references: [id])
  Menu            Menu?            @relation(fields: [menuId], references: [id])
  Organization    Organization?    @relation(fields: [organizationId], references: [id])
  User            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  SecurityReport  SecurityReport[]

  @@index([clientId])
  @@index([organizationId])
  @@index([shortCode])
  @@index([status])
  @@index([type])
  @@index([userId])
}

model SecurityReport {
  id          String    @id
  qrCodeId    String
  reportType  String
  description String?
  reporterIp  String?
  userAgent   String?
  status      String    @default("pending")
  reviewedAt  DateTime?
  reviewedBy  String?
  notes       String?
  createdAt   DateTime  @default(now())
  QRCode      QRCode    @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([status])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Subscription {
  id                   String    @id
  userId               String    @unique
  plan                 String
  status               String
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime
  User                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model Task {
  id          String    @id
  userId      String
  contactId   String?
  title       String
  description String?
  dueDate     DateTime?
  status      String    @default("pending")
  priority    String    @default("medium")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Contact     Contact?  @relation(fields: [contactId], references: [id])
  User        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([dueDate])
  @@index([userId])
}

model User {
  id                   String               @id
  name                 String?
  email                String               @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  role                 UserRole             @default(USER)
  isBanned             Boolean              @default(false)
  bannedReason         String?
  bannedAt             DateTime?
  parentOrganizationId String?
  isSubAccount         Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime
  AIUsage              AIUsage[]
  Account              Account[]
  AuditLog             AuditLog[]
  Client               Client[]
  Contact              Contact[]
  LandingPage          LandingPage[]
  Menu                 Menu[]
  Note                 Note[]
  OrganizationMember   OrganizationMember[]
  PrintOrder           PrintOrder[]
  QRCode               QRCode[]
  Session              Session[]
  Subscription         Subscription?
  Task                 Task[]
  Organization         Organization?        @relation(fields: [parentOrganizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([parentOrganizationId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum PaymentProvider {
  CASHAPP
  VENMO
  ZELLE
  PAYPAL
  STRIPE
  SQUARE
  APPLE_PAY
  GOOGLE_PAY
}

enum QRCodeType {
  URL
  VCARD
  EMAIL
  SMS
  WIFI
  TEXT
  PHONE
  LOCATION
  EVENT
  LANDING_PAGE
  MENU
  PRODUCT
  PAYMENT_LINK
  FILE_DOWNLOAD
  APP_DOWNLOAD
}

enum UserRole {
  USER
  ADMIN
  AGENCY
}
