generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Auth Models
model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  password             String?
  role                 UserRole  @default(USER)
  isBanned             Boolean   @default(false)
  bannedReason         String?
  bannedAt             DateTime?
  parentOrganizationId String?
  isSubAccount         Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  organizations      OrganizationMember[]
  qrCodes            QRCode[]
  clients            Client[]
  landingPages       LandingPage[]
  contacts           Contact[]
  tasks              Task[]
  notes              Note[]
  printOrders        PrintOrder[]
  subscription       Subscription?
  aiUsage            AIUsage[]
  auditLogs          AuditLog[]
  parentOrganization Organization? @relation("SubAccounts", fields: [parentOrganizationId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([parentOrganizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Organization Models
model Organization {
  id           String   @id @default(cuid())
  name         String
  ownerId      String
  plan         String   @default("FREE") // FREE, PRO, BUSINESS, AGENCY
  settings     Json?
  isWhiteLabel Boolean  @default(false)
  customDomain String?  @unique
  branding     Json?
  smtpConfig   Json?
  revenueShare Int      @default(70)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members     OrganizationMember[]
  clients     Client[]
  qrCodes     QRCode[]
  subAccounts User[]               @relation("SubAccounts")

  @@index([ownerId])
  @@index([customDomain])
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String
  joinedAt       DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

// Business Models
model Client {
  id             String        @id @default(cuid())
  userId         String
  organizationId String?
  name           String
  email          String?
  phone          String?
  address        String?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  qrCodes      QRCode[]
  menus        Menu[]

  @@index([userId])
  @@index([organizationId])
}

model QRCode {
  id               String           @id @default(cuid())
  userId           String
  clientId         String?
  organizationId   String?
  name             String
  description      String?
  type             QRCodeType
  data             String           @db.Text
  shortCode        String           @unique
  redirectUrl      String
  style            Json?
  logoUrl          String?
  isDynamic        Boolean          @default(true)
  isSecure         Boolean          @default(false)
  password         String?
  expiresAt        DateTime?
  maxScans         Int?
  scanCount        Int              @default(0)
  status           String           @default("active")
  isActive         Boolean          @default(true)
  isBanned         Boolean          @default(false)
  bannedReason     String?
  bannedAt         DateTime?
  paymentProvider  PaymentProvider?
  paymentHandle    String?
  paymentAmount    Float?
  paymentCurrency  String?          @default("USD")
  paymentNote      String?
  allowTips        Boolean          @default(false)
  tipAmounts       Json?
  menuId           String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  client          Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull)
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  menu            Menu?             @relation(fields: [menuId], references: [id], onDelete: SetNull)
  analytics       Analytics[]
  landingPages    LandingPage[]
  printOrders     PrintOrder[]
  securityReports SecurityReport[]

  @@index([userId])
  @@index([clientId])
  @@index([organizationId])
  @@index([shortCode])
  @@index([type])
  @@index([status])
}

model Analytics {
  id         String   @id @default(cuid())
  qrCodeId   String
  scannedAt  DateTime @default(now())
  deviceType String?
  browser    String?
  os         String?
  country    String?
  city       String?
  ipAddress  String?
  userAgent  String?  @db.Text
  referrer   String?

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([scannedAt])
}

model LandingPage {
  id        String   @id @default(cuid())
  userId    String
  qrCodeId  String?  @unique
  title     String
  slug      String   @unique
  content   Json
  theme     Json?
  published Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  qrCode QRCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([slug])
}

model Menu {
  id              String   @id @default(cuid())
  userId          String
  clientId        String?
  name            String
  description     String?
  slug            String   @unique
  businessName    String?
  businessAddress String?
  businessCity    String?
  businessState   String?
  businessZip     String?
  businessPhone   String?
  businessEmail   String?
  businessWebsite String?
  language        String   @default("en")
  currency        String   @default("USD")
  timezone        String   @default("America/New_York")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client     Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  categories MenuCategory[]
  qrCodes    QRCode[]

  @@index([userId])
  @@index([clientId])
  @@index([slug])
}

model MenuCategory {
  id           String   @id @default(cuid())
  menuId       String
  name         String
  description  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  menu  Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  items MenuItem[]

  @@index([menuId])
}

model MenuItem {
  id           String   @id @default(cuid())
  categoryId   String
  name         String
  description  String?
  price        Float
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  dietaryTags  Json?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([categoryId])
}

// CRM Models
model Contact {
  id          String   @id @default(cuid())
  userId      String
  name        String
  email       String?
  phone       String?
  company     String?
  contactType String   @default("lead")
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]
  notes Note[]

  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  contactId   String?
  title       String
  description String?   @db.Text
  dueDate     DateTime?
  status      String    @default("pending")
  priority    String    @default("medium")
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([contactId])
  @@index([dueDate])
}

model Note {
  id        String   @id @default(cuid())
  contactId String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([userId])
}

// Print & Orders
model PrintOrder {
  id                        String    @id @default(cuid())
  userId                    String
  qrCodeId                  String
  orderNumber               String    @unique
  productType               String
  quantity                  Int
  specifications            Json
  specialInstructions       String?   @db.Text
  shippingAddress           Json
  totalPrice                Float
  status                    String    @default("pending")
  trackingNumber            String?
  customerEmail             String?
  customerPhone             String?
  adminNotificationSent     Boolean   @default(false)
  customerNotificationSent  Boolean   @default(false)
  shippedAt                 DateTime?
  estimatedDelivery         DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([qrCodeId])
  @@index([status])
  @@index([createdAt])
}

// Billing
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  plan                 String
  status               String
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model AIUsage {
  id               String   @id @default(cuid())
  userId           String
  feature          String
  model            String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  cost             Float
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Admin & Security
model SecurityReport {
  id          String    @id @default(cuid())
  qrCodeId    String
  reportType  String
  description String?   @db.Text
  reporterIp  String?
  userAgent   String?   @db.Text
  status      String    @default("pending")
  reviewedAt  DateTime?
  reviewedBy  String?
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)

  @@index([qrCodeId])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  targetType String?
  targetId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Enums
enum UserRole {
  USER
  ADMIN
  AGENCY
}

enum QRCodeType {
  URL
  VCARD
  EMAIL
  SMS
  WIFI
  TEXT
  PHONE
  LOCATION
  EVENT
  LANDING_PAGE
  MENU
  PRODUCT
  PAYMENT_LINK
  FILE_DOWNLOAD
  APP_DOWNLOAD
}

enum PaymentProvider {
  CASHAPP
  VENMO
  ZELLE
  PAYPAL
  STRIPE
  SQUARE
  APPLE_PAY
  GOOGLE_PAY
}
